<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root fx:id="currentPlayerView" type="javafx.scene.layout.VBox" id="currentPlayerView" xmlns="http://javafx.com/javafx/" xmlns:fx="http://javafx.com/fxml/" stylesheets="@../css/style.css" alignment="CENTER">

    <HBox alignment="CENTER" spacing="20.0">

        <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
            <Label fx:id="playerName" id="playerName"></Label>

            <HBox fx:id="labelPane" id="labelPane" alignment="CENTER" spacing="10.0">
                <Label fx:id="money" id="money"></Label>
                <Label fx:id="draw" id="draw"></Label>
                <Label fx:id="discard" id="discard"></Label>
                <Label fx:id="actions" id="actions"></Label>
                <Label fx:id="buys" id="buys"></Label>
                <Label fx:id="pirateship" id="pirateship"></Label>
            </HBox>

            <VBox fx:id="temporarySection" visible="false" managed="false" spacing="5.0">
                <Label text="Cartes révélées" styleClass="label"/>
                <HBox fx:id="temporaryPane" minHeight="200.0" alignment="CENTER" spacing="10.0"
                      style="-fx-border-color: red; -fx-border-style: dashed; -fx-padding: 5;"/>
            </VBox>
            <HBox fx:id="gamePane" id="gamePane" minHeight="200.0" alignment="CENTER" spacing="10.0"></HBox>

            <VBox alignment="CENTER" spacing="15.0">
                <HBox fx:id="yesNoPane" alignment="CENTER" spacing="20.0">
                    <Button fx:id="yesButton" text="Yes" styleClass="bouton-action"/>
                    <Button fx:id="noButton" text="No" styleClass="bouton-action"/>
                </HBox>
                <HBox fx:id="handPane" id="handPane" minHeight="200.0" alignment="CENTER" spacing="10.0"></HBox>
                <Button fx:id="playTreasure" text="Play Treasures" styleClass="bouton-action"/>
            </VBox>
        </VBox>

        <VBox alignment="CENTER" spacing="15.0" styleClass="other-player-native-island" style="-fx-padding: 15; -fx-min-width: 180;">
            <Label text="Native village" styleClass="label"/>
            <HBox alignment="CENTER" minHeight="150" minWidth="150" style="-fx-background-image: url('images/Native_VillageArt.jpg') " styleClass="image-island-native">
                <HBox fx:id="nativePane" alignment="CENTER" spacing="-80.0" style="-fx-scale-x: 0.4; -fx-scale-y: 0.4;"/>
            </HBox>
            <Label text="Island Mat" styleClass="label" />
            <HBox alignment="CENTER" minHeight="150" minWidth="150" style="-fx-background-image: url('images/IslandArt.jpg'); " styleClass="image-island-native">
                <HBox fx:id="islandPane" alignment="CENTER" spacing="-80.0" style="-fx-scale-x: 0.4; -fx-scale-y: 0.4;"/>
            </HBox>

        </VBox>
    </HBox>
</fx:root>