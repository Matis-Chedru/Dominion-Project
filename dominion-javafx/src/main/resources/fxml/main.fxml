<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import fr.umontpellier.iut.dominionfx.views.CurrentPlayerView?>
<?import fr.umontpellier.iut.dominionfx.views.SupplyPileView?>
<?import fr.umontpellier.iut.dominionfx.views.OtherPlayersView?>
<?import javafx.scene.layout.HBox?>

<fx:root fx:id="gameView" type="HBox" xmlns="http://javafx.com/javafx" id="gameView" xmlns:fx="http://javafx.com/fxml" stylesheets="@../css/style.css" alignment="CENTER" spacing="20.0">

    <VBox HBox.hgrow="ALWAYS" alignment="TOP_CENTER" spacing="20.0">
        <OtherPlayersView fx:id="otherPlayersView"/>

        <CurrentPlayerView fx:id="currentPlayerPane" id="currentPlayerView" VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER" spacing="20.0">
            <Label fx:id="instruction" styleClass="texte-standard" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Button fx:id="skipButton" text="Skip" styleClass="bouton-skip"/>
        </HBox>
    </VBox>

    <SupplyPileView fx:id="supplyPileView" id="SupplyPileView" style="-fx-scale-x: 0.75; -fx-scale-y: 0.65; -fx-transform-origin: top right;"/>
</fx:root>